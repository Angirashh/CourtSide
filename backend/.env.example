# Copy to .env and fill in. Never commit the real .env.

# SQLAlchemy URL. Local dev can use SQLite; production should use Postgres (e.g. Supabase pooled connection string).
DATABASE_URL=sqlite:///./demo_frontend.db

# Signing key for access tokens. Generate a fresh one for every environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Only needed if the Celery worker is used (the API does not currently enqueue tasks).
CELERY_BROKER_URL=redis://localhost:6379/0

# Player sign-in (Google). From Google Cloud Console → APIs & Services → Credentials →
# OAuth Client ID (Web application). Must match frontend/.env's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
