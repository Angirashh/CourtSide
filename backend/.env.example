# Copy to .env and fill in. Never commit the real .env.

# SQLAlchemy URL. Local dev can use SQLite; production should use Postgres (e.g. Supabase pooled connection string).
DATABASE_URL=sqlite:///./demo_frontend.db

# Signing key for access tokens. Generate a fresh one for every environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Only needed if the Celery worker is used (the API does not currently enqueue tasks).
CELERY_BROKER_URL=redis://localhost:6379/0

# Player sign-up/login is via Google. Create an OAuth 2.0 Web Client ID in Google Cloud Console
# (APIs & Services > Credentials) and add this backend's + frontend's origins as authorized
# JavaScript origins. Must match VITE_GOOGLE_CLIENT_ID in frontend/.env exactly.
GOOGLE_CLIENT_ID=

# Dormant for now (player sign-in uses Google, see above) -- kept wired for when phone-based
# OTP sign-in is reintroduced at scale. Sent via MSG91 (https://msg91.com): grab the auth key
# from Settings > API, and create an OTP template under OTP > Templates for the template ID.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
